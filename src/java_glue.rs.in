use crate::MessagingClient;
use jni_sys::*;

pub trait OnEvent : Send {
    fn new_message(&self, s: &str);
}

foreign_callback!(callback MessageObserver {
    self_type OnEvent;
    onStateChanged = OnEvent::new_message(&self, s: &str);
});

foreign_class!(class MessagingClient {
    self_type MessagingClient;
    constructor MessagingClient::new(cache: &str) -> MessagingClient;
    fn MessagingClient::onion_service_from_esk(
        &mut self,
        expanded_secret_key: &[i16],
    ) -> String;
    fn MessagingClient::onion_service_from_sk(
        &mut self,
        secret_key: &[i16],
    ) -> String;
    fn MessagingClient::get_onion_address(public_key: &[i16]) -> String;
    fn MessagingClient::generate_key() -> Vec<i16>;
    fn MessagingClient::send_message(
        &mut self,
        message: String,
        onion_address: String,
    ) -> String;
    fn MessagingClient::subscribe(&mut self, _: Box<dyn OnEvent>);
});
