use crate::MessagingClient;
use crate::ChatMessage;
use jni_sys::*;


foreign_typemap!(
    ($p:r_type) Vec<u8> => jbyteArray {
        let slice = &($p)[..];
        let slice = unsafe { std::mem::transmute::<&[u8], &[i8]>(slice) };
        let raw = JavaByteArray::from_slice_to_raw(slice, env);
        $out = raw;
    };
    ($p:f_type) => "jbyteArray";
);

foreign_typemap!(
    ($p:r_type) &'a [u8] => jbyteArray {
        let slice = unsafe { std::mem::transmute::<&[u8], &[i8]>($p) };
        let raw = JavaByteArray::from_slice_to_raw(slice, env);
        $out = raw;
    };
    ($p:f_type) => "jbyteArray";
    ($p:r_type) &'a [u8] <= jbyteArray {
        let arr = JavaByteArray::new(env, $p);
        let slice = arr.to_slice();
        let slice = unsafe { std::mem::transmute::<&[i8], &[u8]>(slice) };
        $out = slice;
    };
    ($p:f_type) <= "jbyteArray";
);

foreign_class!(class ChatMessage{
    self_type ChatMessage;
    constructor ChatMessage::new(mut signature:String, mut data_type:String, mut data:String) -> ChatMessage;
    fn ChatMessage::get_signature(&mut self) -> String;
    fn ChatMessage::get_data_type(&mut self) -> String;
    fn ChatMessage::get_data(&mut self) -> String;
});

pub trait OnEvent : Send {
    fn new_message(&self, s: ChatMessage);
}


foreign_callback!(callback MessageObserver {
    self_type OnEvent;
    onStateChanged = OnEvent::new_message(&self, s: ChatMessage);
});

foreign_class!(class MessagingClient {
    self_type MessagingClient;
    constructor MessagingClient::new(cache: &str) -> MessagingClient;
    fn MessagingClient::onion_service_from_esk(
        &mut self,
        expanded_secret_key: &[u8],
    ) -> String;
    fn MessagingClient::onion_service_from_sk(
        &mut self,
        secret_key: &[u8],
    ) -> String;
    fn MessagingClient::get_onion_address(public_key: &[u8]) -> String;
    fn MessagingClient::generate_key() -> Vec<u8>;
    fn MessagingClient::send_message(&mut self, message: &str, recipient: &str)  -> String;
    fn MessagingClient::get_public_key_from_onion_address(onion_address: &str) -> Vec<u8>;
    fn MessagingClient::verify_signature(data: &str, signature: &[u8], public_key: &[u8]) -> bool;
    fn MessagingClient::subscribe(&mut self, _: Box<dyn OnEvent>);
});
